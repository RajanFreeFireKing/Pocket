# ==============================================================================
# Solus + StreamVex Core Engine - Production Release App Signing Configuration
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this template to create 'keystore.properties' in the repository root:
#      cp keystore.properties.example keystore.properties
#
# 2. Update the values below with your release keystore path and passwords.
#    (Paths can be absolute or relative to the repository root directory).
#
# 3. Generate a release keystore if you don't already have one:
#      bash scripts/create_release_keystore.sh
#
# 4. Build your signed Release APK:
#      ./gradlew assembleRelease
#
# NOTE: 'keystore.properties', '*.jks', and '*.keystore' are in .gitignore
# and will NEVER be committed to Git.
# ==============================================================================

storeFile=release.keystore
storePassword=your_keystore_password_here
keyAlias=solus_release_key
keyPassword=your_key_password_here
